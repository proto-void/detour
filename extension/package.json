{
  "name": "@detour/extension",
  "description": "Detour — point production at your code.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:rogers": "DETOUR_BRAND=rogers wxt build",
    "zip": "DETOUR_OMIT_CHROMIUM_MANIFEST_KEY=1 wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:rogers": "DETOUR_OMIT_CHROMIUM_MANIFEST_KEY=1 DETOUR_BRAND=rogers wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e:chrome": "node e2e/chrome-smoke.mjs",
    "chrome:install": "node scripts/install-chrome.mjs",
    "ci": "pnpm test && pnpm typecheck && pnpm build && pnpm build:firefox && pnpm e2e:chrome && pnpm zip && pnpm zip:firefox",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.3",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "puppeteer-core": "^25.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "valibot": "^1.5.0"
  }
}
