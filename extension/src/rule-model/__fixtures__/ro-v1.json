      "rules": [
        { "id": "r5", "type": "normalOverride", "match": "https://**.example.com/*", "replace": "https://**.staging.example.com/*", "on": true },
        { "id": "r6", "type": "headerRule", "match": "https://x.example.com/*", "requestRules": "", "responseRules": "", "on": true }
