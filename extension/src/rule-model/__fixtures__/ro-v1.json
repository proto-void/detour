        {
          "id": "r3",
          "type": "headerRule",
          "match": "https://api.example.com/*",
          "requestRules": "set X-Debug: 1;remove Cookie",
          "responseRules": "set Access-Control-Allow-Origin: *;remove Content-Security-Policy",
          "on": false
